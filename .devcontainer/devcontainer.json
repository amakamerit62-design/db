{
  "name": "VB.NET RAT Server",
  "image": "mcr.microsoft.com/devcontainers/windows/server:ltsc2022",
  "forwardPorts": [9823, 9824, 9825, 9826],
  "postCreateCommand": "cd /workspaces/db && dotnet build",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ]
    }
  },
  "portsAttributes": {
    "9823": {
      "label": "Server",
      "onAutoForward": "notify"
    }
  }
}

{
  "name": "VB.NET RAT Server",
  "image": "mcr.microsoft.com/devcontainers/windows/server:ltsc2022",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [9823, 9824, 9825, 9826],
  "postCreateCommand": "powershell -Command \"cd C:\\workspaces\\db && dotnet --version && dotnet build\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ]
    }
  },
  "portsAttributes": {
    "9823": {
      "label": "Server",
      "onAutoForward": "notify"
    }
  }
}
